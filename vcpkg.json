{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dearsql",
  "version": "0.1.7",
  "description": "Cross-platform SQL database client",
  "builtin-baseline": "db23990c5a6e2953bf1eb8c86e9a64c73d5b1fa7",
  "dependencies": [
    {
      "name": "sqlite3",
      "features": [
        "dbstat"
      ]
    },
    "nlohmann-json",
    {
      "name": "libpq",
      "features": [
        "openssl"
      ],
      "default-features": false,
      "platform": "!ios"
    },
    "openssl",
    {
      "name": "libmariadb"
    },
    {
      "name": "hiredis",
      "features": [
        "ssl"
      ]
    },
    {
      "name": "mongo-cxx-driver",
      "platform": "!ios"
    },
    {
      "name": "libuv",
      "platform": "!ios"
    },
    "zlib",
    "cpp-httplib",
    "tree-sitter",
    {
      "name": "gtest",
      "platform": "!ios"
    },
    {
      "name": "nativefiledialog-extended",
      "platform": "!ios"
    },
    {
      "name": "glfw3",
      "platform": "!linux & !ios"
    },
    {
      "name": "sentry-native",
      "features": [
        "backend",
        "transport",
        "compression"
      ],
      "platform": "!ios"
    },
    {
      "name": "libiconv",
      "platform": "!ios"
    },
    "spdlog",
    {
      "name": "duckdb",
      "platform": "!ios"
    },
    {
      "name": "ftxui",
      "platform": "!ios"
    },
    {
      "name": "minio-cpp"
    }
  ]
}
