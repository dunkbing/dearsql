{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dearsql",
  "version": "0.1.7",
  "description": "Cross-platform SQL database client",
  "builtin-baseline": "db23990c5a6e2953bf1eb8c86e9a64c73d5b1fa7",
  "dependencies": [
    {
      "name": "sqlite3",
      "features": [
        "dbstat"
      ]
    },
    "nlohmann-json",
    {
      "name": "libpq",
      "features": [
        "openssl"
      ],
      "default-features": false
    },
    "openssl",
    "libmariadb",
    {
      "name": "hiredis",
      "features": [
        "ssl"
      ]
    },
    "mongo-cxx-driver",
    "libuv",
    "zlib",
    "cpp-httplib",
    "md4c",
    "tree-sitter",
    "gtest",
    "nativefiledialog-extended",
    {
      "name": "glfw3",
      "platform": "!linux"
    },
    {
      "name": "sentry-native",
      "features": [
        "backend",
        "transport",
        "compression"
      ]
    },
    "libiconv",
    "spdlog",
    {
      "name": "shaderc",
      "platform": "osx"
    },
    {
      "name": "spirv-cross",
      "platform": "osx"
    },
    "duckdb",
    "ftxui"
  ]
}
